# Run from the pai-search repository root using this exact argument order.
# Prefix matching also permits trailing runner arguments.
prefix_rule(
    pattern = [
        "tools/.venv/bin/python",
        "-B",
        "tools/runner.py",
        "--tool",
        ["tool-url-validate", "tool-webpage-metadata", "tool-webpage-markdown"],
    ],
    decision = "allow",
    justification = "Launch approved project tools through their dedicated sandboxing runner",
    match = [
        "tools/.venv/bin/python -B tools/runner.py --tool tool-url-validate",
        "tools/.venv/bin/python -B tools/runner.py --tool tool-webpage-metadata",
        "tools/.venv/bin/python -B tools/runner.py --tool tool-webpage-markdown",
    ],
    not_match = [
        "tools/.venv/bin/python -m pip install example",
        "tools/.venv/bin/python -B tools/runner.py --tool tool-unknown",
        "tools/.venv/bin/python -B tools/runner.py --worker",
    ],
)
