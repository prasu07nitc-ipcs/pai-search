# Run from the repository root. Match the entire inline code argument exactly.
# Trailing arguments are raw_input/session ID and timeout (0 < seconds <= 5).
# Reads permit any known form-url session ID; they are not restricted to one run.
# Existing forms.rules/tools.rules cover server and extraction runner commands.

prefix_rule(
    pattern = ["forms/.venv/bin/python", "-B", "-c", "import json, re, sys, urllib.request as u\nclass NoRedirect(u.HTTPRedirectHandler):\n    def redirect_request(self, *args):\n        raise ValueError(\"Redirects are not permitted\")\nbase = \"http://127.0.0.1:8765\"\ntimeout = float(sys.argv[2])\nif not 0 < timeout <= 5:\n    raise ValueError(\"Timeout must be greater than zero and at most five seconds\")\nopener = u.build_opener(u.ProxyHandler({}), NoRedirect())\nwith opener.open(base + \"/runtime/config.json\", timeout=timeout) as response:\n    token = json.load(response)[\"token\"]\nbody = json.dumps({\"form\": \"form-url\", \"raw_input\": sys.argv[1], \"initial_data\": {}}).encode(\"utf-8\")\nrequest = u.Request(base + \"/api/sessions\", data=body, headers={\"X-Forms-Token\": token, \"Origin\": base, \"Content-Type\": \"application/json\"})\nwith opener.open(request, timeout=timeout) as response:\n    print(json.dumps(json.load(response), ensure_ascii=False))\n"],
    decision = "allow",
    justification = "Local URL-form session create for authorized task runs",
    match = ["forms/.venv/bin/python -B -c 'import json, re, sys, urllib.request as u\nclass NoRedirect(u.HTTPRedirectHandler):\n    def redirect_request(self, *args):\n        raise ValueError(\"Redirects are not permitted\")\nbase = \"http://127.0.0.1:8765\"\ntimeout = float(sys.argv[2])\nif not 0 < timeout <= 5:\n    raise ValueError(\"Timeout must be greater than zero and at most five seconds\")\nopener = u.build_opener(u.ProxyHandler({}), NoRedirect())\nwith opener.open(base + \"/runtime/config.json\", timeout=timeout) as response:\n    token = json.load(response)[\"token\"]\nbody = json.dumps({\"form\": \"form-url\", \"raw_input\": sys.argv[1], \"initial_data\": {}}).encode(\"utf-8\")\nrequest = u.Request(base + \"/api/sessions\", data=body, headers={\"X-Forms-Token\": token, \"Origin\": base, \"Content-Type\": \"application/json\"})\nwith opener.open(request, timeout=timeout) as response:\n    print(json.dumps(json.load(response), ensure_ascii=False))\n' 'Run task-index-web-page' 5"],
    not_match = ["forms/.venv/bin/python -B -c 'print(1)'"],
)

prefix_rule(
    pattern = ["forms/.venv/bin/python", "-B", "-c", "import json, re, sys, urllib.request as u\nclass NoRedirect(u.HTTPRedirectHandler):\n    def redirect_request(self, *args):\n        raise ValueError(\"Redirects are not permitted\")\nbase = \"http://127.0.0.1:8765\"\ntimeout = float(sys.argv[2])\nif not 0 < timeout <= 5:\n    raise ValueError(\"Timeout must be greater than zero and at most five seconds\")\nopener = u.build_opener(u.ProxyHandler({}), NoRedirect())\nwith opener.open(base + \"/runtime/config.json\", timeout=timeout) as response:\n    token = json.load(response)[\"token\"]\nsid = sys.argv[1]\nif not re.fullmatch(\"[0-9a-f]{32}\", sid):\n    raise ValueError(\"Invalid session ID\")\nrequest = u.Request(base + \"/api/sessions/form-url/\" + sid + \"?view=current\", headers={\"X-Forms-Token\": token})\nwith opener.open(request, timeout=timeout) as response:\n    print(json.dumps(json.load(response), ensure_ascii=False))\n"],
    decision = "allow",
    justification = "Local URL-form session current for authorized task runs",
    match = ["forms/.venv/bin/python -B -c 'import json, re, sys, urllib.request as u\nclass NoRedirect(u.HTTPRedirectHandler):\n    def redirect_request(self, *args):\n        raise ValueError(\"Redirects are not permitted\")\nbase = \"http://127.0.0.1:8765\"\ntimeout = float(sys.argv[2])\nif not 0 < timeout <= 5:\n    raise ValueError(\"Timeout must be greater than zero and at most five seconds\")\nopener = u.build_opener(u.ProxyHandler({}), NoRedirect())\nwith opener.open(base + \"/runtime/config.json\", timeout=timeout) as response:\n    token = json.load(response)[\"token\"]\nsid = sys.argv[1]\nif not re.fullmatch(\"[0-9a-f]{32}\", sid):\n    raise ValueError(\"Invalid session ID\")\nrequest = u.Request(base + \"/api/sessions/form-url/\" + sid + \"?view=current\", headers={\"X-Forms-Token\": token})\nwith opener.open(request, timeout=timeout) as response:\n    print(json.dumps(json.load(response), ensure_ascii=False))\n' 0123456789abcdef0123456789abcdef 5"],
    not_match = ["forms/.venv/bin/python -B -c 'print(1)'"],
)

prefix_rule(
    pattern = ["forms/.venv/bin/python", "-B", "-c", "import json, re, sys, urllib.request as u\nclass NoRedirect(u.HTTPRedirectHandler):\n    def redirect_request(self, *args):\n        raise ValueError(\"Redirects are not permitted\")\nbase = \"http://127.0.0.1:8765\"\ntimeout = float(sys.argv[2])\nif not 0 < timeout <= 5:\n    raise ValueError(\"Timeout must be greater than zero and at most five seconds\")\nopener = u.build_opener(u.ProxyHandler({}), NoRedirect())\nwith opener.open(base + \"/runtime/config.json\", timeout=timeout) as response:\n    token = json.load(response)[\"token\"]\nsid = sys.argv[1]\nif not re.fullmatch(\"[0-9a-f]{32}\", sid):\n    raise ValueError(\"Invalid session ID\")\nrequest = u.Request(base + \"/api/sessions/form-url/\" + sid + \"?view=full\", headers={\"X-Forms-Token\": token})\nwith opener.open(request, timeout=timeout) as response:\n    print(json.dumps(json.load(response), ensure_ascii=False))\n"],
    decision = "allow",
    justification = "Local URL-form session full for authorized task runs",
    match = ["forms/.venv/bin/python -B -c 'import json, re, sys, urllib.request as u\nclass NoRedirect(u.HTTPRedirectHandler):\n    def redirect_request(self, *args):\n        raise ValueError(\"Redirects are not permitted\")\nbase = \"http://127.0.0.1:8765\"\ntimeout = float(sys.argv[2])\nif not 0 < timeout <= 5:\n    raise ValueError(\"Timeout must be greater than zero and at most five seconds\")\nopener = u.build_opener(u.ProxyHandler({}), NoRedirect())\nwith opener.open(base + \"/runtime/config.json\", timeout=timeout) as response:\n    token = json.load(response)[\"token\"]\nsid = sys.argv[1]\nif not re.fullmatch(\"[0-9a-f]{32}\", sid):\n    raise ValueError(\"Invalid session ID\")\nrequest = u.Request(base + \"/api/sessions/form-url/\" + sid + \"?view=full\", headers={\"X-Forms-Token\": token})\nwith opener.open(request, timeout=timeout) as response:\n    print(json.dumps(json.load(response), ensure_ascii=False))\n' 0123456789abcdef0123456789abcdef 5"],
    not_match = ["forms/.venv/bin/python -B -c 'print(1)'"],
)
