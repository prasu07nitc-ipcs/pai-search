# Run from repository root. Lifecycle confirmation still applies.
prefix_rule(
    pattern = [
        "services/.venv/bin/python", "-B", "services/runner.py",
        "--service", "service-webpage-index",
        ["submit", "claim", "finish", "job", "queue-status", "admission"],
    ],
    decision = "allow",
    justification = "Run the webpage-index service queue through the dedicated services runtime",
    match = [
        "services/.venv/bin/python -B services/runner.py --service service-webpage-index queue-status",
        "services/.venv/bin/python -B services/runner.py --service service-webpage-index submit --text example --intent index_webpage",
        "services/.venv/bin/python -B services/runner.py --service service-webpage-index claim --worker-id worker",
        "services/.venv/bin/python -B services/runner.py --service service-webpage-index finish --worker-id worker --job-id example --status completed --result {}",
        "services/.venv/bin/python -B services/runner.py --service service-webpage-index job --job-id example",
        "services/.venv/bin/python -B services/runner.py --service service-webpage-index admission closed",
    ],
    not_match = [
        "services/.venv/bin/python -c code",
        "services/.venv/bin/python -m pip install example",
        "services/.venv/bin/python -B services/service-test/receiver.py submit --text hello",
        "services/.venv/bin/python -B services/runner.py --service unknown queue-status",
    ],
)
